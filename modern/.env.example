# Sledge Classroom 2.0 — Firebase client configuration (public config)
#
# Copy this file to `.env` (or `.env.local` for local-only overrides) and fill
# in the real values from your Firebase project settings.
#
# These values are public client configuration (Firebase web API key, project
# ID, etc.) — they are identifiers, not secrets. Real security is enforced by
# Firebase Security Rules (Firestore + Realtime Database), never by hiding
# these values.
#
# NEVER put service-account credentials, Admin SDK keys, private keys, or
# other server secrets in this file. The client must never hold admin
# credentials.

# Firebase project (from Firebase Console -> Project settings -> General)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=sledge-classroom.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sledge-classroom
VITE_FIREBASE_DATABASE_URL=https://sledge-classroom-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=sledge-classroom.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
